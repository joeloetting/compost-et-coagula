---
import { getEntries, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { type Article, getWriting, typeLabels } from '../../utils/content';

export async function getStaticPaths() {
	const entries = await getWriting();
	return entries.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
const { Content } = await render(article);
const projects = await getEntries(article.data.projects);
---

<ArticleLayout article={article}>
	<Content />
	{/* Search filters, read by Pagefind when it indexes the built site (see pagefind.yml). */}
	<span hidden data-pagefind-filter={`type:${typeLabels[article.data.type]}`}></span>
	{projects.map((project) => <span hidden data-pagefind-filter={`project:${project.data.title}`} />)}
</ArticleLayout>
