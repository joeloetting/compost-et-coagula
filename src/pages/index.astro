---
import { getEntries } from 'astro:content';
import { SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { type Article, getProjects, getWriting, projectPath, typeLabels, writingPath } from '../utils/content';
import { url } from '../utils/urls';

// The home page is the volume's table of contents: the most recent pieces, under
// the year each was published, newest first, with a link to the full archive.
// Dates are publication dates; there are no volume or issue numbers until there
// are real collections to number.
const CONTENTS_LIMIT = 8;
const writing = await getWriting();
const items = await Promise.all(
	writing.slice(0, CONTENTS_LIMIT).map(async (entry) => ({ entry, projects: await getEntries(entry.data.projects) })),
);
const years = new Map<number, typeof items>();
for (const item of items) {
	const year = item.entry.data.published.getUTCFullYear();
	years.set(year, [...(years.get(year) ?? []), item]);
}
const projects = await getProjects();

const dayMonth = (date: Date) => date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', timeZone: 'UTC' });
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
const typeOf = (entry: Article) => typeLabels[entry.data.type];
---

<BaseLayout>
	<p class="intro">{SITE_DESCRIPTION}</p>

	<section class="contents" aria-labelledby="contents-heading">
		<h2 class="contents-title" id="contents-heading">Contents</h2>
		{writing.length === 0 && <p class="empty">The first essays are in preparation.</p>}
		{
			[...years].map(([year, entries]) => (
				<section class="year" aria-labelledby={`year-${year}`}>
					<h3 class="year-title" id={`year-${year}`}>
						{year}
					</h3>
					<ol class="toc">
						{entries.map(({ entry, projects }) => (
							<li>
								<p class="toc-line">
									<a class="toc-title" href={url(writingPath(entry))}>
										{entry.data.title}
									</a>
									{entry.data.draft && <span class="badge">Draft</span>}
									<span class="leader" aria-hidden="true" />
									<time class="toc-date" datetime={isoDate(entry.data.published)}>
										{dayMonth(entry.data.published)}
									</time>
								</p>
								<p class="toc-description">{entry.data.description}</p>
								<p class="meta">
									{typeOf(entry)}
									{projects.map((project) => (
										<>
											<span aria-hidden="true"> · </span>
											<a href={url(projectPath(project))}>{project.data.title}</a>
										</>
									))}
								</p>
							</li>
						))}
					</ol>
				</section>
			))
		}
		{
			writing.length > 0 && (
				<p class="archive-link">
					<a href={url('/writing/')}>
						{writing.length > CONTENTS_LIMIT ? `Complete archive (${writing.length} pieces)` : 'Complete archive'}
					</a>
				</p>
			)
		}
	</section>

	{
		projects.length > 0 && (
			<section class="contents projects" aria-labelledby="projects-heading">
				<h2 class="contents-title" id="projects-heading">
					Ongoing projects
				</h2>
				<ul class="toc">
					{projects.map((project) => (
						<li>
							<p class="toc-line">
								<a class="toc-title" href={url(projectPath(project))}>
									{project.data.title}
								</a>
							</p>
							<p class="toc-description">{project.data.description}</p>
						</li>
					))}
				</ul>
			</section>
		)
	}
</BaseLayout>

<style>
	.intro {
		max-width: 38rem;
		font-size: 1.2em;
		line-height: 1.55;
		color: var(--muted-ink);
	}

	.contents {
		max-width: var(--measure);
		margin-top: var(--space-section);
	}

	/* "Contents" set like the heading of a book's contents page: centered, in
	   spaced capitals, between rules. */
	.contents-title {
		padding-block: 0.6rem;
		border-block: 1px solid var(--rule);
		font-size: 0.875rem;
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		text-align: center;
		color: var(--accent);
	}

	.year {
		margin-top: 2rem;
	}

	.year-title {
		font-size: 1.125rem;
		font-weight: 400;
		letter-spacing: 0.08em;
		color: var(--muted-ink);
	}

	.toc {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.toc li {
		padding-block: 1.1rem;
	}

	.toc li + li {
		border-top: 1px solid var(--rule);
	}

	/* Title, dotted leader, and date on one line, as in a printed contents
	   page. The date drops below the title when there is no room. */
	.toc-line {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		column-gap: 0.5rem;
	}

	.toc-title {
		font-size: 1.375rem;
		font-weight: 600;
		line-height: 1.3;
		color: var(--ink);
		text-decoration: none;
	}

	.toc-title:hover {
		text-decoration: underline;
		text-decoration-thickness: 1px;
	}

	.leader {
		flex: 1 1 3rem;
		min-width: 3rem;
		border-bottom: 2px dotted var(--rule);
	}

	.toc-date {
		font-family: var(--sans);
		font-size: var(--text-meta);
		color: var(--muted-ink);
		white-space: nowrap;
	}

	.toc-description {
		margin-top: 0.3rem;
		font-style: italic;
		line-height: 1.5;
		color: var(--muted-ink);
	}

	.meta {
		margin-top: 0.35rem;
	}

	.archive-link {
		margin-top: 1.25rem;
		padding-top: 1rem;
		border-top: 1px solid var(--rule);
		font-family: var(--sans);
		font-size: var(--text-small);
	}

	.projects .toc-title {
		font-size: 1.2rem;
	}
</style>
