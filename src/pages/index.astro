---
import { Image } from 'astro:assets';
import ArticleList from '../components/ArticleList.astro';
import FormattedDate from '../components/FormattedDate.astro';
import fool from '../content/writing/dancing-on-the-cliffs-edge/fool.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getWriting, writingPath } from '../utils/content';
import { url } from '../utils/urls';

const writing = (await getWriting()).filter((entry) => !entry.data.draft);
const featured = writing.find((entry) => entry.id === 'holy-saturday-in-oak-ridge')
	?? writing.find((entry) => entry.id === 'dancing-on-the-cliffs-edge')
	?? writing.find((entry) => entry.data.type === 'essay');
const latest = writing.filter((entry) => entry.id !== featured?.id).slice(0, 4);
const oakRidge = '/projects/the-cruciform-ground/';
---

<BaseLayout>
	<div class="front">
		<p class="intro">Essays on land, history, theology, and the forms through which we inherit them.</p>

		{featured && (
			<section class="feature" aria-labelledby="feature-title">
				<div>
					<p class="eyebrow">Featured essay</p>
					<h2 id="feature-title"><a href={url(writingPath(featured))}>{featured.data.title}</a></h2>
					<p class="summary">{featured.data.description}</p>
					<p class="meta"><FormattedDate date={featured.data.published} /></p>
				</div>
				{featured.id === 'dancing-on-the-cliffs-edge' && (
					<figure>
						<Image src={fool} alt="Woodcut of the Fool walking with a bundle and staff as a dog leaps at his leg." widths={[240, 400, 560]} sizes="(max-width: 39rem) 240px, 280px" />
						<figcaption>The Fool, from <cite>Meditations on the Tarot</cite></figcaption>
					</figure>
				)}
			</section>
		)}

		<div class="departments">
			<section aria-labelledby="oak-ridge-title">
				<h2 id="oak-ridge-title"><a href={url(oakRidge)}>Oak Ridge</a></h2>
				<p>The Cruciform Ground follows displacement, contamination, and the theology of the cross in one Tennessee place.</p>
				<a class="entry" href={url(oakRidge + '#who-was-moved')}>Begin with the land and its people</a>
			</section>
			<section aria-labelledby="criticism-title">
				<h2 id="criticism-title"><a href={url('/criticism/')}>Criticism</a></h2>
				<p>Close readings of books, images, buildings, and forms, with an invitation to answer back.</p>
				<a class="entry" href={url('/criticism/#responding-to-an-essay')}>Respond to an essay</a>
			</section>
		</div>

		<section class="latest" aria-labelledby="latest-title">
			<h2 id="latest-title">{latest.length ? 'Latest writing' : 'Essays'}</h2>
			{latest.length > 0 && <ArticleList entries={latest} headingLevel={3} />}
			<p><a href={url('/writing/')}>Browse the archive</a></p>
		</section>
	</div>
</BaseLayout>

<style>
	.front {
		--editorial-accent: #783e31;
		max-width: 62.5rem;
		margin-inline: auto;
	}

	.intro {
		max-width: 39ch;
		margin: 0 0 clamp(2rem, 5vw, 4rem);
		font-size: clamp(1.3rem, 1.1rem + 0.9vw, 1.9rem);
		line-height: 1.4;
	}

	.feature {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 1.5rem clamp(1.5rem, 6vw, 5rem);
		padding-block: clamp(1.5rem, 4.5vw, 3.5rem);
		border-top: 2px solid var(--ink);
		border-bottom: 1px solid var(--rule);
	}

	.feature h2 {
		max-width: 15ch;
		margin: 0.5rem 0 0;
		font-size: clamp(2.15rem, 1.45rem + 3vw, 4.2rem);
		line-height: 1.03;
		letter-spacing: -0.035em;
	}

	.feature .eyebrow {
		color: var(--editorial-accent);
	}

	.feature .summary {
		max-width: 42ch;
		margin: 0.9rem 0;
	}

	figure {
		width: clamp(11rem, 22vw, 16rem);
		margin: 0;
	}

	figure img {
		display: block;
		width: 100%;
		max-height: 18rem;
		object-fit: contain;
		object-position: left;
	}

	figcaption {
		margin-top: 0.55rem;
		color: var(--muted-ink);
		font: 0.85rem/1.4 var(--sans);
	}

	.departments {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem clamp(1.5rem, 6vw, 5rem);
		padding-block: 1.75rem;
		border-bottom: 1px solid var(--rule);
	}

	.departments h2,
	.latest h2 {
		font-size: clamp(1.4rem, 1.2rem + 1vw, 2rem);
	}

	.departments p {
		max-width: 37ch;
		margin: 0.45rem 0;
	}

	h2 a {
		color: var(--ink);
	}

	.entry {
		font: var(--text-small)/1.5 var(--sans);
	}

	.latest {
		margin-top: 2.25rem;
	}

	.latest > p {
		margin-top: 1rem;
	}

	@media (max-width: 39rem) {
		.feature,
		.departments {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
