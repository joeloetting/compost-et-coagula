---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils/urls';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found." noindex>
	<div class="not-found">
		<header class="page-header">
			<h1>Page not found</h1>
			<p class="lede">There is nothing at this address. It may have moved, or the link may be mistyped.</p>
		</header>
		<ul>
			<li><a href={url('/')}>Return to the front page</a></li>
			<li><a href={url('/writing/')}>Browse all writing</a></li>
		</ul>
	</div>
</BaseLayout>

<style>
	.not-found {
		max-width: var(--measure);
		margin-inline: auto;
	}

	ul {
		padding-left: 1.25em;
	}

	li + li {
		margin-top: 0.4em;
	}
</style>
