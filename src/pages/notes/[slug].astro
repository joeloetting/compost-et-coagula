---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNotes, type Note } from '../../utils/content';
import { url } from '../../utils/urls';

export async function getStaticPaths() {
	const notes = await getNotes();
	return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props as { note: Note };
const { Content } = await render(note);
---

<BaseLayout title={note.data.title} description={note.data.description} noindex={note.data.draft}>
	<article class="note-page">
		<header class="page-header">
			<p class="eyebrow">
				<a href={url('/notes/')}>Note</a>
				{note.data.draft && <span class="badge">Draft</span>}
			</p>
			<h1>{note.data.title}</h1>
		</header>
		<div class="prose">
			<Content />
		</div>

		{
			note.data.links.length > 0 && (
				<section class="section" aria-labelledby="links-heading">
					<h2 class="section-title" id="links-heading">Links</h2>
					<ul class="links">
						{note.data.links.map((link) => (
							<li>
								<a href={link.url}>{link.label}</a>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</article>
</BaseLayout>

<style>
	.note-page {
		max-width: var(--measure);
		margin-inline: auto;
	}

	.page-header h1 {
		margin-top: 0.75rem;
	}

	.eyebrow a {
		color: inherit;
	}

	.section {
		margin-top: var(--space-section);
	}

	.links {
		padding-left: 1.25em;
	}
</style>
