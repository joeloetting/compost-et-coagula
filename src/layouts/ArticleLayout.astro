---
import { SITE_LICENSE, SITE_TITLE } from '../consts';
import ArticleMeta from '../components/ArticleMeta.astro';
import ArticleOutline from '../components/ArticleOutline.astro';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';
import { type Article, articleAuthor, articleLicense, articleProjects, getWriting, projectPath, writingPath } from '../utils/content';
import { articleSchema } from '../utils/seo';
import { url } from '../utils/urls';

interface Props {
	article: Article;
	headings: { depth: number; slug: string; text: string }[];
}

const { article, headings } = Astro.props;
const { title, description, published, updated, correction, draft } = article.data;
const projects = await articleProjects(article);
// The site's license is stated once, in the footer; an article mentions its
// own only when it differs from that, or carries a note about its sources.
const license = articleLicense(article);
// Show other published pieces from the same inquiry, without guessing at
// thematic recommendations or offering drafts as a reader's next destination.
const writing = projects.length ? await getWriting() : [];
const continuations = projects.map((project) => ({
	project,
	entries: writing.filter((entry) => entry.id !== article.id && !entry.data.draft &&
		entry.data.projects.some(({ id }) => id === project.id)).slice(0, 2),
})).filter(({ entries }) => entries.length > 0);

// Running heads for printed pages: the publication on the left, the article on
// the right. Written as CSS strings, with "<" escaped so the title cannot close
// the style element.
const cssString = (text: string) => JSON.stringify(text).replaceAll('<', '\\3c ');
const printHeads = `@page { @top-left { content: ${cssString(SITE_TITLE)}; } @top-right { content: ${cssString(title)}; } }`;
---

<BaseLayout
	title={title}
	subtitle={article.data.subtitle}
	description={description}
	ogType="article"
	published={published}
	updated={updated}
	noindex={draft}
	author={articleAuthor(article).name}
	schema={articleSchema(article, Astro.site)}
	license={license.url}
>
	<style is:inline slot="head" set:html={printHeads} />
	<article class="article">
		<ArticleMeta article={article} projects={projects} />
		<ArticleOutline headings={headings} />
		<div class="prose">
			<slot />
		</div>
		{
			correction && (
				<aside class="editorial-note" id="editorial-note" aria-labelledby="editorial-note-heading">
					<h2 id="editorial-note-heading">Editorial note</h2>
					<p>
						{updated && (
							<>
								<FormattedDate date={updated} />.{' '}
							</>
						)}
						{correction}
					</p>
				</aside>
			)
		}
		<footer class="article-footer">
			{
				(license.custom || license.rights) && (
					<p class="rights-note">
						{license.custom && (
							<>
								This piece is published under{' '}
								{license.url ? <a href={license.url} rel="license">{license.name}</a> : license.name}, not the site’s default license.{' '}
							</>
						)}
						{license.rights && <>{license.rights} </>}
						See <a href={url(SITE_LICENSE.path)}>copyright and reuse</a>.
					</p>
				)
			}
			{continuations.map(({ project, entries }) => (
				<nav class="continue-reading" aria-label={`More from ${project.data.title}`}>
					<p class="eyebrow">More from {project.data.title}</p>
					<ul>{entries.map((entry) => <li><a href={url(writingPath(entry))}>{entry.data.title}</a></li>)}</ul>
				</nav>
			))}
			<p><a href={url('/writing/')}>All writing</a></p>
			<p><a href={url('/criticism/')}>Criticism &amp; corrections</a></p>
			{
				projects.map((project) => (
					<p>
						Part of <a href={url(projectPath(project))}>{project.data.title}</a>
					</p>
				))
			}
		</footer>
	</article>
</BaseLayout>

<script>
	// A shape-note divider that cites its music prints its note number beside
	// the notes (print.css). Browsers that cannot style a closed disclosure's
	// content need the divider opened for printing; it is closed again after.
	const opened: HTMLDetailsElement[] = [];
	addEventListener('beforeprint', () => {
		for (const details of document.querySelectorAll<HTMLDetailsElement>('.shapenote details.sn-disclosure:not([open])')) {
			if (!details.querySelector('[data-footnote-ref]')) continue;
			details.open = true;
			opened.push(details);
		}
	});
	addEventListener('afterprint', () => {
		for (const details of opened.splice(0)) details.open = false;
	});
</script>

<style>
	.rights-note {
		flex-basis: 100%;
		max-width: var(--measure);
		margin-bottom: 0.75rem;
		color: var(--muted-ink);
	}

	.rights-note a {
		color: inherit;
	}

	.continue-reading {
		flex-basis: 100%;
		margin-bottom: 0.75rem;
	}

	.continue-reading ul {
		margin: 0.5rem 0 0;
		padding-left: 1.25rem;
	}

	.continue-reading li + li {
		margin-top: 0.5rem;
	}

	.article-footer {
		clear: both;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
		margin-top: var(--space-section);
		padding-top: 1.25rem;
		border-top: 1px solid var(--rule);
		font-family: var(--sans);
		font-size: var(--text-small);
	}
</style>
