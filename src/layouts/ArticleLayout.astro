---
import { getEntries } from 'astro:content';
import { SITE_TITLE } from '../consts';
import ArticleMeta from '../components/ArticleMeta.astro';
import BaseLayout from './BaseLayout.astro';
import { type Article, projectPath } from '../utils/content';
import { articleSchema } from '../utils/seo';
import { url } from '../utils/urls';

interface Props {
	article: Article;
}

const { article } = Astro.props;
const { title, description, published, updated, draft } = article.data;
const projects = await getEntries(article.data.projects);

// Running heads for printed pages: the publication on the left, the article on
// the right. Written as CSS strings, with "<" escaped so the title cannot close
// the style element.
const cssString = (text: string) => JSON.stringify(text).replaceAll('<', '\\3c ');
const printHeads = `@page { @top-left { content: ${cssString(SITE_TITLE)}; } @top-right { content: ${cssString(title)}; } }`;
---

<BaseLayout
	title={title}
	subtitle={article.data.subtitle}
	description={description}
	ogType="article"
	published={published}
	updated={updated}
	noindex={draft}
	schema={articleSchema(article, Astro.site)}
>
	<style is:inline slot="head" set:html={printHeads} />
	<article class="article">
		<ArticleMeta article={article} projects={projects} />
		<div class="prose">
			<slot />
		</div>
		<footer class="article-footer">
			<p><a href={url('/writing/')}>All writing</a></p>
			{
				projects.map((project) => (
					<p>
						Part of <a href={url(projectPath(project))}>{project.data.title}</a>
					</p>
				))
			}
		</footer>
	</article>
</BaseLayout>

<style>
	.article-footer {
		clear: both;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
		margin-top: var(--space-section);
		padding-top: 1.25rem;
		border-top: 1px solid var(--rule);
		font-family: var(--sans);
		font-size: var(--text-small);
	}
</style>
