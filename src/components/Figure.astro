---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { figureAnchor } from '../utils/figures';
import { url } from '../utils/urls';

interface Props {
	/** An imported image (preferred), or a path to a file in public/, e.g. "/images/map.png". */
	src: ImageMetadata | string;
	/** Short text alternative. Use alt="" only for purely decorative images. */
	alt: string;
	/** Names the figure so the text can refer to it with <FigureRef to="..." />. */
	id?: string;
	/** Leave this figure out of the numbering (decorative images). */
	unnumbered?: boolean;
	/** Credit for the maker of the image, e.g. "Photograph by Jane Doe." */
	credit?: string;
	/** Where the image comes from: archive, publication, or dataset. */
	source?: string;
	/** Link for the source, when it is online. */
	sourceUrl?: string;
	/** Key of an entry in the article's bibliography, e.g. cite="smith-1909"; the source links to it. */
	cite?: string;
	/** Copyright or license status, e.g. "Public domain" or "CC BY 4.0". */
	license?: string;
	licenseUrl?: string;
	/** Let the figure extend beyond the text column (maps, diagrams). */
	wide?: boolean;
	/** A small figure set to one side, partly in the margin on wide screens (sketches, specimens). */
	inset?: boolean;
	/** Intrinsic size; needed only for public/ paths, to prevent layout shift. */
	width?: number;
	height?: number;
	/** Set at build time by src/plugins/figures.mjs; do not pass these by hand. */
	number?: string;
	citeText?: string;
}

const { src, alt, id, credit, source, sourceUrl, cite, citeText, license, licenseUrl, wide = false, inset = false, width, height, number } = Astro.props;
const anchor = id ? figureAnchor(id) : number ? `figure-${number}` : undefined;
const sourceText = source ?? citeText;
const sourceHref = cite ? `#ref-${cite}` : sourceUrl;
const hasAttribution = Boolean(credit || sourceText || license);
// Responsive widths for raster images, never larger than the original, which is
// also the most a raster image is displayed at, so small images are not blurred.
const widths = typeof src === 'string' ? [] : [640, 1000, 1600, 2000].filter((w) => w < src.width).concat(src.width);
const hasCaption = Astro.slots.has('default');
// Slot "description": a longer explanation for maps and diagrams, shown on request.
const hasDescription = Astro.slots.has('description');
---

<figure id={anchor} class:list={['figure', { 'figure--wide': wide, 'figure--inset': inset && !wide }]}>
	{
		typeof src === 'string' ? (
			<img src={src.startsWith('/') ? url(src) : src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
		) : src.format === 'svg' ? (
			<Image src={src} alt={alt} loading="lazy" />
		) : (
			<Image
				src={src}
				alt={alt}
				widths={widths}
				sizes={wide ? '(min-width: 1080px) 1000px, 100vw' : inset ? '320px' : '(min-width: 800px) 720px, 100vw'}
				style={`max-width: ${src.width}px`}
				loading="lazy"
			/>
		)
	}
	{
		(number || hasCaption || hasAttribution || hasDescription) && (
			<figcaption>
				{number && <span class="figure-label">Figure {number}.</span>}
				{hasCaption && <slot />}
				{
					hasAttribution && (
						<p class="attribution">
							{credit && <span>{credit}</span>}
							{sourceText && (
								<span>
									Source: {sourceHref ? <a href={sourceHref}>{sourceText}</a> : sourceText}
								</span>
							)}
							{license && <span>{licenseUrl ? <a href={licenseUrl}>{license}</a> : license}</span>}
						</p>
					)
				}
				{hasDescription && (
					<details>
						<summary>Full description</summary>
						<div>
							<slot name="description" />
						</div>
					</details>
				)}
			</figcaption>
		)
	}
</figure>
