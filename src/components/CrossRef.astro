---
/**
 * A cross-reference in the margin to another article or project that develops
 * the same question. Place it inline, like a marginal note:
 *
 *   ...the valley's earlier history.<CrossRef to="another-essay-slug" />
 *   ...<CrossRef project="the-cruciform-ground">for the project's terms</CrossRef>
 *
 * `to` is an article's file name without extension; `project` a project's. The
 * title is filled in from the target, and a misspelled slug fails the build. A
 * target that is still a draft is named without a link until it is published.
 * Optional text inside the tag follows the title.
 */
import { getEntry } from 'astro:content';
import Marginalia from './Marginalia.astro';
import { projectPath, showDrafts, writingPath } from '../utils/content';
import { url } from '../utils/urls';

type Props = { to: string; project?: never } | { project: string; to?: never };

const { to, project } = Astro.props;

let title: string;
let href: string | undefined;
if (to) {
	const entry = await getEntry('writing', to);
	if (!entry) throw new Error(`CrossRef: no article named "${to}" in src/content/writing/.`);
	title = entry.data.title;
	if (showDrafts || !entry.data.draft) href = url(writingPath(entry));
} else if (project) {
	const entry = await getEntry('projects', project);
	if (!entry) throw new Error(`CrossRef: no project named "${project}" in src/content/projects/.`);
	title = entry.data.title;
	href = url(projectPath(entry));
} else {
	throw new Error('CrossRef needs either `to` (an article) or `project`.');
}

const hasText = Astro.slots.has('default');
---

<Marginalia kind="crossref" name="Cross-reference"
	><i>See</i> {href ? <a href={href}>{title}</a> : <span class="crossref-pending">{title} (not yet published)</span>}{
		hasText && (
			<>
				{' '}
				<slot />
			</>
		)
	}</Marginalia
>
