---
/**
 * A marginal note: a short interpretive observation set beside the passage it
 * belongs to. Place it inline, at the end of the sentence it comments on, and
 * keep its text on one line (no blank lines), since it sits inside a paragraph:
 *
 *   ...where history starts.<MarginNote>Where should the account begin?</MarginNote>
 *
 * Wide screens show it in the margin. Narrow screens show a small "note" mark
 * that expands the note in place; this works without JavaScript and from the
 * keyboard. Sources and citations belong in footnotes, not here.
 */
import Marginalia from './Marginalia.astro';
---

<Marginalia kind="note" name="Marginal note"><slot /></Marginalia>
