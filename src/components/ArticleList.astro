---
import { getEntries } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { type Article, projectPath, typeLabels, writingPath } from '../utils/content';
import { url } from '../utils/urls';

interface Props {
	entries: Article[];
	/** Heading level for entry titles, so the list fits the page's outline. */
	headingLevel?: 2 | 3;
	/** Hide project names, e.g. on a project's own page. */
	showProjects?: boolean;
}

const { entries, headingLevel = 2, showProjects = true } = Astro.props;
const Heading = `h${headingLevel}` as const;

const items = await Promise.all(
	entries.map(async (entry) => ({
		entry,
		projects: showProjects ? await getEntries(entry.data.projects) : [],
	})),
);
---

<ul class="article-list">
	{
		items.map(({ entry, projects }) => (
			<li>
				<Heading class="title">
					<a href={url(writingPath(entry))}>{entry.data.title}</a>
					{entry.data.draft && <span class="badge">Draft</span>}
				</Heading>
				<p class="description">{entry.data.description}</p>
				<p class="meta">
					<FormattedDate date={entry.data.published} />
					<span aria-hidden="true"> · </span>
					{typeLabels[entry.data.type]}
					{projects.map((project) => (
						<>
							<span aria-hidden="true"> · </span>
							<a href={url(projectPath(project))}>{project.data.title}</a>
						</>
					))}
				</p>
			</li>
		))
	}
</ul>

<style>
	.article-list {
		margin: 0;
		padding: 0;
		list-style: none;
		max-width: var(--measure);
	}

	li {
		padding-block: 1.5rem;
		border-bottom: 1px solid var(--rule);
	}

	li:first-child {
		padding-top: 1rem;
	}

	.title {
		font-size: 1.375rem;
		line-height: 1.3;
	}

	.title a {
		color: var(--ink);
		text-decoration: none;
	}

	.title a:hover {
		text-decoration: underline;
		text-decoration-thickness: 1px;
	}

	.description {
		margin-top: 0.4rem;
	}

	.meta {
		margin-top: 0.5rem;
	}
</style>
