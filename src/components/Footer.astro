---
import { SITE_AUTHOR, SITE_LICENSE, SITE_TITLE } from '../consts';
import { copyrightYears, getNotes } from '../utils/content';
import { url } from '../utils/urls';

// Linked only once a note is published, so the link never leads to an empty list.
const hasNotes = (await getNotes()).length > 0;
const years = await copyrightYears();
---

<footer class="site-footer">
	<div class="container footer-inner">
		<div>
			<p><a href={url('/')}>{SITE_TITLE}</a> is an independent publication.</p>
			<p class="rights">
				© {years} {SITE_AUTHOR.name}. Unless otherwise noted, <a href={url(SITE_LICENSE.path)}>licensed {SITE_LICENSE.name}</a>.
			</p>
		</div>
		<ul>
			<li><a href={url('/writing/')}>Writing</a></li>
			<li><a href={url('/projects/')}>Projects</a></li>
			{hasNotes && <li><a href={url('/notes/')}>Site notes</a></li>}
			<li><a href={url('/about/')}>About</a></li>
			<li><a href={url('/search/')}>Search</a></li>
			<li><a href={url('/rss.xml')}>RSS</a></li>
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--rule);
		font-family: var(--sans);
		font-size: var(--text-small);
		color: var(--muted-ink);
	}

	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.75rem 2rem;
		padding-block: 2rem 2.5rem;
	}

	a {
		color: inherit;
	}

	.rights {
		margin-top: 0.25rem;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>
