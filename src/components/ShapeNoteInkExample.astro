---
// Enlarged, live renderer samples for the appendix. No separate music data.
import { getEntry } from 'astro:content';
import { resolvePhrase } from '../lib/shapeNotes/notation';
import { renderPhraseSvg } from '../lib/shapeNotes/render';
interface Props { phrase: string }
const { phrase: id } = Astro.props;
const entry = await getEntry('shapeNotes', id);
if (!entry) throw new Error(`Unknown ink-example phrase: ${id}`);
const phrase = resolvePhrase({ id: entry.id, ...entry.data });
const plain = renderPhraseSvg(phrase, { filterId: `appendix-plain-${id}` });
const textured = renderPhraseSvg(phrase, { filterId: `appendix-texture-${id}` });
---
<figure class="ink-example">
  <figcaption>{phrase.title}: the same notes, enlarged</figcaption>
  <div class="sample no-filter">
    <p>Without the surface filter</p>
    <div role="img" aria-label={`${phrase.title}, enlarged notes without surface filtering`}><Fragment set:html={plain.svg} /></div>
  </div>
  <div class="sample">
    <p>With the screen's ink texture</p>
    <div role="img" aria-label={`${phrase.title}, the same enlarged notes with ink texture`}><Fragment set:html={textured.svg} /></div>
  </div>
  <p class="sample-words">{phrase.lyric}</p>
</figure>
<style>
  .ink-example { margin: 2rem 0; padding: 1rem; border: 1px solid var(--muted-ink); }
  figcaption { font-weight: 600; }
  .sample p, .sample-words { font-size: 0.85rem; color: var(--muted-ink); }
  .sample > div { max-width: 30rem; margin-inline: auto; }
  .sample :global(svg) { display: block; width: 100%; height: auto; color: var(--ink); }
  .no-filter :global(svg g) { filter: none; }
  @media print { .sample :global(svg g) { filter: none; } }
</style>
