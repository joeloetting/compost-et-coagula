---
interface Props {
	date: Date;
}

const { date } = Astro.props;
// Frontmatter dates are calendar dates (parsed as UTC midnight), so format in UTC
// to avoid showing the previous day in western time zones.
const label = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<time datetime={date.toISOString().slice(0, 10)}>{label}</time>
