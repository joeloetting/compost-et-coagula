---
import FormattedDate from './FormattedDate.astro';
import { type Article, type Project, articleAuthor, projectPath, typeLabels } from '../utils/content';
import { url } from '../utils/urls';

interface Props {
	article: Article;
	projects: Project[];
}

const { article, projects } = Astro.props;
const { title, subtitle, description, published, updated, type, correction, draft } = article.data;
const author = articleAuthor(article);
---

<header class="article-header">
	<p class="eyebrow">
		{typeLabels[type]}
		{
			projects.map((project) => (
				<>
					<span aria-hidden="true"> · </span>
					<a href={url(projectPath(project))}>{project.data.title}</a>
				</>
			))
		}
		{draft && <span class="badge">Draft</span>}
	</p>
	<h1>
		{title}
		{subtitle && <span class="subtitle">{subtitle}</span>}
	</h1>
	{/* Skip the description when it only repeats the subtitle. */}
	{description !== subtitle && <p class="description">{description}</p>}
	<p class="byline">
		By <a href={url(author.path)} rel="author">{author.name}</a>
	</p>
	<p class="meta dates">
		<span>Published <FormattedDate date={published} /></span>
		{
			updated && (
				<span>
					<span aria-hidden="true"> · </span>Updated <FormattedDate date={updated} />
				</span>
			)
		}
	</p>
	{
		correction && (
			<p class="revision-notice">
				<strong>Revised{updated && <> <FormattedDate date={updated} /></>}.</strong>{' '}
				<a href="#editorial-note">Read the editorial note</a> for what changed.
			</p>
		)
	}
</header>

<style>
	.article-header {
		max-width: var(--measure);
		margin-bottom: clamp(2.25rem, 5vw, 3.5rem);
		padding-bottom: clamp(1.75rem, 4vw, 2.5rem);
		border-bottom: 1px solid var(--rule);
	}

	.eyebrow a {
		color: inherit;
	}


	h1 {
		margin-top: 0.75rem;
		font-size: clamp(2.125rem, 1.4rem + 2.6vw, 3.125rem);
		line-height: 1.12;
		letter-spacing: -0.015em;
	}

	/* Part of the heading, as on a title page, but set smaller and in italic. */
	.subtitle {
		display: block;
		margin-top: 0.5rem;
		font-size: 0.55em;
		font-style: italic;
		font-weight: 400;
		line-height: 1.3;
		letter-spacing: 0;
		color: var(--muted-ink);
	}

	.description {
		margin-top: 1rem;
		font-size: 1.15em;
		line-height: 1.5;
		color: var(--muted-ink);
	}

	.byline {
		margin-top: 1.25rem;
		font-family: var(--sans);
		font-size: var(--text-small);
		letter-spacing: 0.01em;
	}

	.byline a {
		color: var(--ink);
		text-decoration: none;
	}

	.byline a:hover {
		text-decoration: underline;
		text-decoration-thickness: 1px;
	}

	.dates {
		margin-top: 0.25rem;
	}

	/* A substantive revision is announced here and explained at the end. */
	.revision-notice {
		margin-top: 1rem;
		padding: 0.5rem 0.875rem;
		background: var(--surface);
		border-left: 2px solid var(--accent);
		font-family: var(--sans);
		font-size: var(--text-small);
		line-height: 1.5;
	}

	.revision-notice strong {
		font-weight: 600;
	}
</style>
