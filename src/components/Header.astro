---
import { SITE_TITLE } from '../consts';
import { url } from '../utils/urls';

const links = [
	{ href: '/writing/', label: 'Writing' },
	{ href: '/projects/', label: 'Projects' },
	{ href: '/about/', label: 'About' },
	{ href: '/search/', label: 'Search' },
];

const path = Astro.url.pathname;
const isHome = path === url('/');

// A section link is current on its own page and on the pages beneath it.
function state(href: string) {
	const target = url(href);
	if (path === target) return 'page';
	if (path.startsWith(target)) return 'true';
	return undefined;
}
---

<header class:list={['site-header', { home: isHome }]}>
	<div class="container header-inner">
		{isHome ? <h1 class="site-title">{SITE_TITLE}</h1> : <a class="site-title" href={url('/')}>{SITE_TITLE}</a>}
		<nav aria-label="Main">
			<ul>
				{
					links.map(({ href, label }) => (
						<li>
							<a href={url(href)} aria-current={state(href)}>
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--rule);
	}

	.header-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		padding-block: 1.25rem;
	}

	.site-title {
		font-family: var(--serif);
		font-size: 1.375rem;
		font-weight: 600;
		letter-spacing: -0.005em;
		color: var(--ink);
		text-decoration: none;
	}

	.home .header-inner {
		padding-block: clamp(2rem, 5vw, 3.5rem) 1.5rem;
	}

	.home .site-title {
		font-size: clamp(2.25rem, 1.6rem + 3vw, 3.5rem);
		letter-spacing: -0.015em;
		line-height: 1.1;
	}

	nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	nav a {
		display: inline-block;
		padding-block: 0.25rem;
		font-family: var(--sans);
		font-size: 1rem;
		color: var(--ink);
		text-decoration: none;
		border-bottom: 2px solid transparent;
	}

	nav a:hover {
		border-bottom-color: var(--rule);
	}

	nav a[aria-current] {
		border-bottom-color: var(--accent);
	}
</style>
